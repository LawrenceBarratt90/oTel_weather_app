# Copy to .env and fill in. .env is gitignored: never commit real tokens.

# --- Dynatrace: where traces are sent (read in telemetry.py) ---
# OTLP base URL of your tenant. Note the dynatrace.com domain, not apps.dynatrace.com.
DT_ENDPOINT=https://<your-env-id>.live.dynatrace.com/api/v2/otlp
# API token with the openTelemetryTrace.ingest scope (create under Access tokens). Ingest only; it cannot read data.
DT_API_TOKEN=dt0c01.xxxxx
# Service name shown in Dynatrace; filter spans on it: fetch spans | filter service.name == "weather-ai-demo"
OTEL_SERVICE_NAME=weather-ai-demo

# --- Local model (read in app.py) ---
# 11435 = the dedicated instance from ./start-ollama.sh. Use 11434 for a normal shared Ollama.
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=llama3.2:1b
